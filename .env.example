# --- Required -------------------------------------------------------------

# Signs session cookies. 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# True Markets organization API key (dashboard.truemarkets.co → API keys).
# Either paste the downloaded JSON file's contents (raw or base64)...
TM_API_KEY_JSON=
# ...or, locally, point at the file:
# TM_KEY_FILE=/absolute/path/to/truemarkets-org-api-key.json

# Signer key (P-256 private key, 64 hex chars) that approves wallet transactions.
# Users are bound to the signer key they were created with, so never rotate it casually.
# Generate one with:  node scripts/new-signer-key.mjs
TM_SIGNER_PRIVATE_KEY=
# ...or, locally:
# TM_SIGNER_KEY_FILE=/absolute/path/to/signer-key.json

# --- Production ------------------------------------------------------------

# Postgres connection string (Neon, Supabase, Railway...). Unset = embedded PGlite in .data/.
DATABASE_URL=

# Protects /api/cron/auto-invest. Vercel Cron sends it as a Bearer token automatically.
CRON_SECRET=

# --- Optional --------------------------------------------------------------
# MIN_ORDER_USD=1
# MAX_ORDER_USD=250
# TM_API_BASE=https://api.truemarkets.co
# TM_EXTERNAL_REF_PREFIX=jarful
